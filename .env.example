# Top-level overview of the credentials used across this project.
# Each sub-project has its own .env.example with the full variable list
# and sane defaults — copy the relevant one(s) to a local ".env" file:
#
#   swiss-grounding-mcp/server/.env.example         (MCP server: OJP, AeroDataBox, SerpApi, ...)
#   swiss-grounding-mcp/agent-backend/.env.example  (FastAPI agent backend: OpenAI)
#   swiss-grounding-mcp/frontend/.env.example       (Vite frontend: Mapbox, backend URL)

# OpenAI (chat agent + Whisper voice transcription)
OPENAI_API_KEY=

# Mapbox GL JS (interactive route map)
VITE_MAPBOX_TOKEN=

# Swiss Open Transport Data (OJP 2.0 - train connections, stop boards, fares)
OJP_API_TOKEN=
