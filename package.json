{
  "name": "swiss-hacks26",
  "private": true,
  "scripts": {
    "dev:web": "npm --prefix swiss-grounding-mcp/frontend run dev -- --port 3000",
    "dev:api": "cd swiss-grounding-mcp/agent-backend && .venv\\Scripts\\python.exe -m uvicorn agent_backend.main:app --reload --port 3001",
    "dev:mcp": "cd swiss-grounding-mcp/server && .venv\\Scripts\\python.exe -m swiss_grounding_mcp.server --transport streamable-http --port 8000",
    "dev:voice": "cd swiss-grounding-mcp/server && .venv\\Scripts\\python.exe voice_assistant.py",
    "test:server": "cd swiss-grounding-mcp/server && .venv\\Scripts\\python.exe -m pytest tests",
    "test:api": "cd swiss-grounding-mcp/agent-backend && .venv\\Scripts\\python.exe -m pytest tests",
    "test:web": "npm --prefix swiss-grounding-mcp/frontend run test",
    "test:all": "npm run test:server && npm run test:api && npm run test:web"
  }
}
