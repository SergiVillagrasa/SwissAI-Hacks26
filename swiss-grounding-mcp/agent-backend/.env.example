OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AGENT_MAX_OUTPUT_TOKENS=1024
AGENT_BACKEND_HOST=127.0.0.1
AGENT_BACKEND_PORT=3001
AGENT_BACKEND_API_KEY=
AGENT_RATE_LIMIT_PER_MINUTE=30
AGENT_DAILY_REQUEST_LIMIT=0
# Set only when every request passes through a proxy that overwrites it.
# Otherwise clients can spoof it. Leave empty to use the TCP peer address.
# On Railway, check that the edge overwrites client-supplied X-Real-IP
# before relying on it.
AGENT_CLIENT_IP_HEADER=
MAX_AUDIO_UPLOAD_BYTES=10485760
CORS_ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Local development only: accept any localhost/127.0.0.1 port.
CORS_ALLOW_ANY_LOCAL_PORT=true
