OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AGENT_BACKEND_HOST=127.0.0.1
AGENT_BACKEND_PORT=3001
CORS_ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Also accept any http(s)://localhost:<port> or http(s)://127.0.0.1:<port>
# origin (dev proxies, Vite's port fallback, etc.) on top of the explicit
# list above. Set to false to lock CORS down to exactly CORS_ALLOWED_ORIGIN.
CORS_ALLOW_ANY_LOCAL_PORT=true
